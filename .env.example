# Configuracion CLIENTE de Firebase (publica por naturaleza, NO es un secreto).
# Copiar a .env.local y rellenar con los valores de Firebase Console > Configuracion del proyecto > Tus apps.
# NUNCA poner aqui contrasenas, claves de cuenta de servicio ni tokens privilegiados.
VITE_FIREBASE_API_KEY=REEMPLAZAR
VITE_FIREBASE_AUTH_DOMAIN=REEMPLAZAR.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REEMPLAZAR
VITE_FIREBASE_STORAGE_BUCKET=REEMPLAZAR.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=REEMPLAZAR
VITE_FIREBASE_APP_ID=REEMPLAZAR

# Email de la unica cuenta creada a mano en Firebase Console (identificador fijo, no se pregunta en la UI).
VITE_LOGIN_EMAIL=REEMPLAZAR@ejemplo.com
