rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Datos privados: solo el UID propietario concreto, en cualquier subcoleccion.
    // El UID de abajo es el de la unica cuenta propietaria. Verificado con el emulador:
    // npm run test:rules
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.uid == 'oGQgZ33jxNedwDHKnEcuO6qAqK43';
    }

    // Denegar todo lo demas de forma explicita (sin sesion o UID ajeno).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
